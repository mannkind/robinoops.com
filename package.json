{
  "name": "robinoops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-pdfjs.ts",
    "prebuild": "npm run check && node scripts/vendor-pdfjs.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
